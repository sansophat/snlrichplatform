{
  "name": "snlrich",
  "version": "1.0.0",
  "private": true,
  "description": "SNLRICH - multi-merchant marketplace with points, cashback and referral rewards",
  "scripts": {
    "postinstall": "node scripts/prepare-db.mjs",
    "dev": "node scripts/prepare-db.mjs --no-generate && next dev",
    "build": "node scripts/prepare-db.mjs && next build",
    "start": "next start",
    "db:push": "node scripts/prepare-db.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prepare-db.mjs && prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "npm run db:push && npm run db:seed",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.18"
  }
}
