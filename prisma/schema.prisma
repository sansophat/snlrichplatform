// NOTE: the datasource provider is switched automatically by scripts/prepare-db.mjs
// based on DATABASE_URL (file: => sqlite, postgres:// => postgresql).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum-like string values (kept as String for SQLite/Postgres compatibility):
//   User.role        CUSTOMER | MERCHANT | ADMIN
//   Merchant.status  PENDING | ACTIVE | SUSPENDED
//   Order.status     PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED
//   Transaction.type POINTS | CASH
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  passwordHash     String
  role             String   @default("CUSTOMER")
  avatarUrl        String?
  phone            String?
  address          String?
  points           Int      @default(0)
  walletCents      Int      @default(0)
  referralCode     String   @unique
  referredById     String?
  referredBy       User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]   @relation("Referrals")
  referralRewarded Boolean  @default(false)
  createdAt        DateTime @default(now())

  // KYC Verification
  kycStatus           String    @default("NOT_SUBMITTED") // NOT_SUBMITTED | PENDING | VERIFIED | REJECTED | BYPASSED
  kycDocumentType     String?
  kycDocumentUrl      String?
  kycDocumentBackUrl  String?
  kycFullName         String?
  kycIdNumber         String?
  kycNotes            String?
  kycSubmittedAt      DateTime?
  kycReviewedAt       DateTime?

  merchant        Merchant?
  orders          Order[]
  wishlist        WishlistItem[]
  reviews         Review[]
  transactions    Transaction[]
  depositRequests DepositRequest[]
}

model Merchant {
  id             String   @id @default(cuid())
  ownerId        String   @unique
  owner          User     @relation(fields: [ownerId], references: [id])
  name           String
  slug           String   @unique
  description    String   @default("")
  emoji          String   @default("🏪")
  logoUrl        String?
  bannerUrl      String?
  phone          String?
  address        String?
  status         String   @default("PENDING")
  pointsRate     Int      @default(1)
  cashbackPct    Float    @default(3)
  commissionPct  Float    @default(10)
  walletCents    Int      @default(0)
  payoutMethod   String?
  payoutDetails  String?
  createdAt      DateTime @default(now())

  products Product[]
  orders   Order[]
  payouts  PayoutRequest[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  emoji     String    @default("🛍️")
  imageUrl  String?
  createdAt DateTime  @default(now())

  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id])
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  name           String
  slug           String   @unique
  description    String   @default("")
  priceCents     Int
  compareAtCents Int?
  stock          Int      @default(0)
  imageUrl       String?
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  approvalStatus String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  approvalNotes  String?
  createdAt      DateTime @default(now())

  orderItems OrderItem[]
  wishlist   WishlistItem[]
  reviews    Review[]

  @@index([merchantId])
  @@index([categoryId])
}

model Order {
  id                 String   @id @default(cuid())
  groupId            String
  number             String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  merchantId         String
  merchant           Merchant @relation(fields: [merchantId], references: [id])
  status             String   @default("PENDING")
  paymentMethod      String   @default("COD")
  paymentStatus      String   @default("UNPAID")
  subtotalCents      Int
  discountCents      Int      @default(0)
  pointsUsed         Int      @default(0)
  pointsDiscountCents Int     @default(0)
  walletUsedCents    Int      @default(0)
  shippingCents      Int      @default(0)
  totalCents         Int
  pointsEarned       Int      @default(0)
  cashbackCents      Int      @default(0)
  commissionCents    Int      @default(0)
  rewardsGranted     Boolean  @default(false)
  couponCode         String?
  shippingName       String
  shippingPhone      String
  shippingAddress    String
  trackingNumber     String?
  carrier            String?
  merchantNotes      String?
  createdAt          DateTime @default(now())

  items        OrderItem[]
  transactions Transaction[]

  @@index([userId])
  @@index([merchantId])
  @@index([groupId])
}

model PayoutRequest {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amountCents Int
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAID
  method      String   @default("BANK_TRANSFER")
  details     String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String
  priceCents Int
  quantity   Int
}

// Ledger for points (type POINTS, amount = points) and wallet cashback (type CASH, amount = cents).
model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  amount    Int
  reason    String
  note      String   @default("")
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  percentOff       Int
  minSubtotalCents Int       @default(0)
  usesLeft         Int?
  expiresAt        DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

model WishlistItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model PlatformSetting {
  id                   String   @id @default("global")
  siteName             String   @default("SNLRICH")
  siteTagline          String   @default("SHOP · EARN · REPEAT")
  supportPhone         String   @default("(123) 456-7890")
  currencySymbol       String   @default("$")
  logoUrl              String?
  logoLightUrl         String?
  signupBonusPoints    Int      @default(100)
  referredBonusPoints  Int      @default(300)
  referrerBonusPoints  Int      @default(500)
  pointValueCents      Int      @default(1)
  freeShippingCents    Int      @default(5000)
  flatShippingCents    Int      @default(500)
  updatedAt            DateTime @updatedAt
}

model PlatformBank {
  id            String   @id @default(cuid())
  bankName      String
  bankCode      String?  // ABA, WING, ACLEDA, BAKONG, CANADIA, etc.
  accountName   String
  accountNumber String
  currency      String   @default("USD") // USD or KHR
  qrImageUrl    String?
  logoUrl       String?
  instructions  String?
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deposits      DepositRequest[]
}

model DepositRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankId        String?
  bank          PlatformBank? @relation(fields: [bankId], references: [id])
  bankName      String
  accountNumber String?
  amountCents   Int
  currency      String   @default("USD")
  receiptUrl    String?
  reference     String?
  notes         String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNotes    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

